CACHE_ENABLED=true

# Internal
INTERNAL_API_KEY=

# Market visibility (which markets appear in the watchlist picker /
# Agent API catalog / home AI radar).
#
# Primary knob (recommended):
#   ENABLED_MARKETS — CSV whitelist. When set, ONLY these markets are
#   visible everywhere. Unknown values are ignored. Empty = whitelist
#   disabled (falls back to the legacy SHOW_* flags below).
#   Valid values: Crypto, USStock, CNStock, HKStock, Forex, Futures, MOEX
#   Examples:
#     ENABLED_MARKETS=Crypto,USStock           # crypto + US stocks only
#     ENABLED_MARKETS=Crypto                   # crypto-only deployment
#     ENABLED_MARKETS=                         # unset → legacy flags apply
# ENABLED_MARKETS=
#
# Legacy flags (kept for back-compat; ignored when ENABLED_MARKETS is set):
#   SHOW_CN_STOCK (default false) — China A-shares
#   SHOW_HK_STOCK (default true)  — Hong Kong stocks
# All other known markets default to visible.
SHOW_CN_STOCK=false
# SHOW_HK_STOCK=true
# Per-process REST completion of private-stream fill snapshots.
# Counts snapshots; a venue snapshot may use multiple HTTP calls.
EXECUTION_FILL_SNAPSHOT_MIN_SEC=2
EXECUTION_FILL_SNAPSHOT_MAX_PER_MIN=30

# Polymarket public-data eligibility and continuous paper observer (no wallet or order access)
POLYMARKET_GEOBLOCK_TTL_SECONDS=900
POLYMARKET_GEOBLOCK_REFRESH_MIN_SECONDS=30
POLYMARKET_OBSERVER_ENABLED=false
POLYMARKET_OBSERVER_MARKET_COUNT=20
POLYMARKET_OBSERVER_SIZE_SHARES=100
POLYMARKET_OBSERVER_MIN_EDGE=0
POLYMARKET_OBSERVER_NEAR_MISS_BPS=50
POLYMARKET_OBSERVER_REFRESH_SECONDS=1800
POLYMARKET_OBSERVER_REST_POLL_SECONDS=10
POLYMARKET_OBSERVER_RETENTION_DAYS=30
POLYMARKET_OBSERVER_NEAR_MISS_RETENTION_DAYS=7
POLYMARKET_OBSERVER_STALE_GRACE_SECONDS=60
POLYMARKET_OBSERVER_WS_ENABLED=true
# 1 (observer command and compose default): each hot Up/Down group parses in its
# own process. 0 keeps the single-process engine. Compose passes this into the
# observer container; an explicit 0 wins over the command default. Paper-only.
# POLYMARKET_OBSERVER_PROCESS_PER_GROUP=1
# 1: inside a feed process, a backup sleeps 1ms while its live primary queue
# holds a frame older than 50ms. Default 0. The in-process engine ignores this.
# POLYMARKET_OBSERVER_PRIMARY_FIRST=0
POLYMARKET_OBSERVER_MERGE_COST=0.02
# Separate opt-in for recurring crypto Up/Down public paper research.
POLYMARKET_OBSERVER_UPDOWN_ENABLED=false
POLYMARKET_OBSERVER_UPDOWN_ASSETS=BTC,ETH,SOL,XRP
POLYMARKET_OBSERVER_UPDOWN_INTERVALS=5m,15m,1h,4h,1d
POLYMARKET_OBSERVER_UPDOWN_LOOKAHEAD_SECONDS=1800
POLYMARKET_OBSERVER_UPDOWN_REFRESH_SECONDS=60
POLYMARKET_OBSERVER_UPDOWN_MAX_MARKETS=40
POLYMARKET_OBSERVER_UPDOWN_PER_PAIR_LIMIT=2
POLYMARKET_OBSERVER_UPDOWN_SAMPLE_SECONDS=5
POLYMARKET_OBSERVER_UPDOWN_SAMPLE_RETENTION_DAYS=7
POLYMARKET_OBSERVER_REFERENCE_CACHE_SECONDS=5
# Sub-second spot: Binance public bookTicker mid over WebSocket (stream.binance.com, then
# data-stream.binance.vision), with the REST reference above kept running as fallback. No credentials.
# Served while younger than FRESH_MS, else REST. aggTrade adds the exchange->receive lag metric.
# With it on, consider POLYMARKET_PAPER_MAKER_SPOT_STALE_MS=1000; see deploy/pm_spot_ws_20261016.md.
POLYMARKET_OBSERVER_SPOT_WS_ENABLED=false
POLYMARKET_OBSERVER_SPOT_WS_FRESH_MS=1000
POLYMARKET_OBSERVER_SPOT_WS_AGGTRADE=true

# Public observer: receive/evaluate/write isolation. No credentials or orders.
POLYMARKET_OBSERVER_EVALUATE_MS=250
# Queue capacity in atomic observation groups (typically one or two SQL records).
# Full queue evicts/coalesces research; evaluator waits if only episode operations remain.
POLYMARKET_OBSERVER_WRITE_QUEUE_MAX=10000
POLYMARKET_OBSERVER_WRITE_BATCH_SIZE=500
POLYMARKET_OBSERVER_WRITE_BATCH_MS=1000
# 1–8 shards minimum; whole markets balanced by measured EWMA activity.
# Grow up to 8 shards when this target would be exceeded (not a hard limit).
POLYMARKET_OBSERVER_WS_ASSETS_PER_SHARD=12
# Initial raw-frame FIFO capacity per shard; grows without dropping deltas.
POLYMARKET_OBSERVER_WS_RECEIVE_QUEUE_MAX=2048
# Elastic FIFO hard limit; overflow requests snapshots on the same connection.
POLYMARKET_OBSERVER_WS_RECEIVE_QUEUE_CEILING=16384
# Keep Linux TCP receive autotuning by default. Positive values explicitly set
# SO_RCVBUF (kernel may clamp/double); inspect transport.rcvbuf_bytes before use.
POLYMARKET_OBSERVER_WS_RCVBUF_BYTES=0
# BTC/ETH 5m and 15m have permanent staggered hot backups regardless of rate.
# First backups start eagerly with paced initial batches. Replacements wait
# only for the primary's remaining 90–120s target age plus 0–30s full jitter.
# Cold standbys are disabled; the legacy ROTATE_SECONDS alone cannot enable them.
POLYMARKET_OBSERVER_WS_COLD_ROTATION_ENABLED=0
POLYMARKET_OBSERVER_WS_ROTATE_SECONDS=0
POLYMARKET_OBSERVER_WS_MAX_BYTES_PER_S=262144
POLYMARKET_OBSERVER_WS_ROTATE_PREPARE_SECONDS=30
# Established busy streams only: healthy PONG but data bytes below 5% of baseline.
POLYMARKET_OBSERVER_WS_ROTATE_QUIET_SECONDS=5
POLYMARKET_OBSERVER_WS_ROTATE_MIN_BYTES_PER_S=16384
POLYMARKET_OBSERVER_WS_SHARDS=4
# Balance groups: an Up/Down series (all its windows) or one YES/NO market.
# Attributed msg/s across healthy windows; raw ingress bytes/frames are measured separately.
POLYMARKET_OBSERVER_WS_REBALANCE_SECONDS=60
POLYMARKET_OBSERVER_WS_REBALANCE_MIN_SECONDS=120
POLYMARKET_OBSERVER_WS_REBALANCE_MAX_GROUPS=8
# Two consecutive samples confirm pressure; each moved group stays put for 5 minutes.
POLYMARKET_OBSERVER_WS_REBALANCE_CONFIRMATIONS=2
POLYMARKET_OBSERVER_WS_GROUP_COOLDOWN_SECONDS=300
# Require actual peak reduction >=10% and >=10 msg/s; isolate dominant groups.
# Max/min RATIO and TARGET_RATIO from #73 are now legacy diagnostics only.
POLYMARKET_OBSERVER_WS_REBALANCE_MIN_MSG_PER_S=10
POLYMARKET_OBSERVER_WS_HOT_GROUP_MSG_PER_S=100
POLYMARKET_OBSERVER_WS_HOT_GROUP_SHARE=0.15
POLYMARKET_OBSERVER_WS_REBALANCE_HYSTERESIS=0.1
POLYMARKET_OBSERVER_WS_RATE_HALF_LIFE_SECONDS=30
# GIL hand-off in the observer process (ms); 0 keeps Python's 5 ms default.
POLYMARKET_OBSERVER_GIL_SWITCH_MS=0.5

# Shared continuous virtual account; public book data only, scheduler-worker opt-in.
POLYMARKET_PAPER_ACCOUNT_ENABLED=false
# New paper taker attempts are disabled; existing inventory still resolves.
POLYMARKET_PAPER_ACCOUNT_TAKER_ENABLED=false
POLYMARKET_PAPER_ACCOUNT_INITIAL_CAPITAL=5000
POLYMARKET_PAPER_ACCOUNT_TRADE_CAP=1000
POLYMARKET_PAPER_ACCOUNT_FREE_FRACTION=0.20
POLYMARKET_PAPER_ACCOUNT_LOCKED_FRACTION=0.60
POLYMARKET_PAPER_ACCOUNT_LOSS_FRACTION=0.02
POLYMARKET_PAPER_ACCOUNT_MIN_EDGE_BPS=10
POLYMARKET_PAPER_ACCOUNT_FULL_EDGE_BPS=100
POLYMARKET_PAPER_ACCOUNT_MIN_TICKET=10
POLYMARKET_PAPER_ACCOUNT_SIZE_STEP=0.01
POLYMARKET_PAPER_ACCOUNT_SLIPPAGE=0
POLYMARKET_PAPER_ACCOUNT_COMPETITOR_TOP=0.50
POLYMARKET_PAPER_ACCOUNT_COMPETITOR_OTHER=0
POLYMARKET_PAPER_ACCOUNT_MERGE_COST=0.02
POLYMARKET_PAPER_ACCOUNT_MERGE_ENABLED=true
POLYMARKET_PAPER_ACCOUNT_SETTLEMENT_SECONDS=60
POLYMARKET_PAPER_ACCOUNT_COOLDOWN_SECONDS=60
POLYMARKET_PAPER_ACCOUNT_DEFAULT_LATENCY_MS=150
POLYMARKET_PAPER_ACCOUNT_LATENCY_MULTIPLIER=1
POLYMARKET_PAPER_ACCOUNT_LATENCY_REFRESH_SECONDS=300
POLYMARKET_PAPER_ACCOUNT_MAX_BOOK_AGE_MS=2000
POLYMARKET_PAPER_ACCOUNT_HISTORY_SECONDS=10
POLYMARKET_PAPER_ACCOUNT_HISTORY_EVENTS=2000
POLYMARKET_PAPER_ACCOUNT_RETENTION_DAYS=90

# Default: observer runs in app.commands.polymarket_observer, never scheduler.
# Legacy single-role fallback only; stop the dedicated role before enabling.
POLYMARKET_OBSERVER_IN_SCHEDULER=false

# Observer recording (public data only; uses the existing asynchronous writer).
# Scope: YES/NO always, plus these Up/Down assets x intervals (unset/empty = BTC,ETH x 5m,15m).
# Recording only narrows UPDOWN discovery. Wider scopes need 20261016_polymarket_recording_scope.sql
# first; see deploy/pm_recording_scope_20261016.md for row rates. Observer itself still defaults off.
POLYMARKET_OBSERVER_RECORDING_ENABLED=true
POLYMARKET_OBSERVER_RECORDING_ASSETS=BTC,ETH
POLYMARKET_OBSERVER_RECORDING_INTERVALS=5m,15m
POLYMARKET_OBSERVER_BOOK_MIN_INTERVAL_MS=1000
POLYMARKET_OBSERVER_RECORDING_BUFFER_MAX=10000
# Target: depth/book snapshots 3 days, public trades 14 days (bounds 1–365).
POLYMARKET_OBSERVER_RECORDING_RETENTION_DAYS=3
# Unset/empty trades retention falls back to recording retention (default 7).
POLYMARKET_OBSERVER_TRADES_RETENTION_DAYS=14
# Indexed, chunked cleanup per table every 10 minutes. Increase for larger scopes.
POLYMARKET_OBSERVER_RECORDING_CLEANUP_BATCH=100000
POLYMARKET_OBSERVER_WINDOW_RETENTION_DAYS=30
POLYMARKET_OBSERVER_RESOLUTION_POLL_SECONDS=60
# Current PolyBolt TWAP requires auth. This flag ONLY attempts an anonymous
# BTC/ETH subscription, never reads credentials; auth_required disables retries.
# Current 5m AND 15m reference lookback is 60s (changelog 2026-08-14).
POLYMARKET_OBSERVER_TWAP_ENABLED=false
POLYMARKET_OBSERVER_TWAP_MIN_INTERVAL_MS=1000
POLYMARKET_OBSERVER_TWAP_RETENTION_DAYS=7

# Paper-only v3 fair-value maker inside the paper-account worker; account and observer gates required.
# No wallet, signing or real orders. See deploy/pm_maker_v3_20261016.md.
POLYMARKET_PAPER_MAKER_ENABLED=false
# Selection: shadow ladder covers the universe; at most MAX_ACTIVE cells get paper capital.
# Cold-start priors apply until a cell has MIN_MARKETS settled markets; ":preopen" = pre-open only.
POLYMARKET_PAPER_MAKER_UNIVERSE_ASSETS=BTC,ETH,SOL,XRP
POLYMARKET_PAPER_MAKER_UNIVERSE_INTERVALS=5m,15m,1h,4h,1d
# Defaults use only cells the observer records by default (RECORDING_INTERVALS=5m,15m). 5m pre-open quoting
# also needs the next market discovered early (UPDOWN_LOOKAHEAD_SECONDS>=300, UPDOWN_PER_PAIR_LIMIT>=2).
# Adding 1h needs UPDOWN_INTERVALS and RECORDING_INTERVALS to include 1h. See deploy/pm_maker_v3_tuning_20261016.md.
POLYMARKET_PAPER_MAKER_COLD_START=BTC:15m,ETH:15m,BTC:5m:preopen,ETH:5m:preopen
POLYMARKET_PAPER_MAKER_REVIEW_UTC=00:05
POLYMARKET_PAPER_MAKER_LOOKBACK_DAYS=7
POLYMARKET_PAPER_MAKER_HALFLIFE_DAYS=3
POLYMARKET_PAPER_MAKER_MIN_MARKETS=150
POLYMARKET_PAPER_MAKER_MIN_FILLED_SHARES=1000
POLYMARKET_PAPER_MAKER_AS_EDGE_RATIO_MAX=.7
POLYMARKET_PAPER_MAKER_MAX_ACTIVE=6
POLYMARKET_PAPER_MAKER_MAX_ACTIVE_PER_COIN=3
POLYMARKET_PAPER_MAKER_PROBATION_DAYS=3
POLYMARKET_PAPER_MAKER_PROBATION_SIZE_MULT=.5
POLYMARKET_PAPER_MAKER_EXIT_COOLOFF_DAYS=3
POLYMARKET_PAPER_MAKER_EXIT_MIN_MARKETS=50
POLYMARKET_PAPER_MAKER_MIN_QUOTABLE_SHARE=.20
POLYMARKET_PAPER_MAKER_MIN_TAKER_VOLUME=2000
POLYMARKET_PAPER_MAKER_TIGHT_SPREAD_TICKS=2
POLYMARKET_PAPER_MAKER_MIN_TIGHT_SHARE=.5
POLYMARKET_PAPER_MAKER_MAX_STALE_SHARE=.02
POLYMARKET_PAPER_MAKER_BOOTSTRAP_ITERS=2000
POLYMARKET_PAPER_MAKER_LCB_ALPHA=.10
# Fair value and toxicity. Spot is the Binance reference (REST, or WebSocket with
# POLYMARKET_OBSERVER_SPOT_WS_ENABLED); its age is added to LATENCY_EFF_S.
POLYMARKET_PAPER_MAKER_SIGMA_PRIOR_ANNUAL=.5
POLYMARKET_PAPER_MAKER_VOL_HALFLIFE_SHORT_S=300
POLYMARKET_PAPER_MAKER_VOL_HALFLIFE_LONG_S=14400
POLYMARKET_PAPER_MAKER_VOL_MIX=.5
POLYMARKET_PAPER_MAKER_VOL_SCALE=1
# Reduce-only when |F - M| > GAP_MAX or Z > Z_HARD_MAX (calibrated on recordings, see the tuning note).
POLYMARKET_PAPER_MAKER_GAP_MAX=.06
POLYMARKET_PAPER_MAKER_LATENCY_EFF_S=.30
POLYMARKET_PAPER_MAKER_SIGMA_SHORT_WINDOW_S=60
POLYMARKET_PAPER_MAKER_Z_HARD_MAX=.03
# The model shades a side's fair below the book microprice only when lower by more than FAIR_TOL (0 = min(F, M)).
POLYMARKET_PAPER_MAKER_FAIR_TOL=.03
# Quote = conservative fair - half spread; opening sides only join/improve the best bid.
POLYMARKET_PAPER_MAKER_H_MIN=.01
POLYMARKET_PAPER_MAKER_K_TOX=1
POLYMARKET_PAPER_MAKER_LAM_FEE=1
POLYMARKET_PAPER_MAKER_C0=0
POLYMARKET_PAPER_MAKER_K_HEDGE=1.5
POLYMARKET_PAPER_MAKER_E_NEG=0
POLYMARKET_PAPER_MAKER_ROUND_TOL_TICKS=.2
POLYMARKET_PAPER_MAKER_MAX_IMPROVE_TICKS=1
POLYMARKET_PAPER_MAKER_HEDGE_MAX_BEHIND_TICKS=3
# Opening quotes may rest up to this many ticks behind the best bid (0 = join/improve only).
POLYMARKET_PAPER_MAKER_OPEN_MAX_BEHIND_TICKS=3
POLYMARKET_PAPER_MAKER_FAIR_MIN=.10
POLYMARKET_PAPER_MAKER_FAIR_MAX=.90
POLYMARKET_PAPER_MAKER_SPREAD_SPIKE_MULT=2
POLYMARKET_PAPER_MAKER_BASE_SIZE=10
POLYMARKET_PAPER_MAKER_MAX_ORDER=25
POLYMARKET_PAPER_MAKER_KAPPA_INV=.02
POLYMARKET_PAPER_MAKER_N_CAP=20
POLYMARKET_PAPER_MAKER_TIME_MULT_CAP=3
POLYMARKET_PAPER_MAKER_FLOW_TICKS=1
POLYMARKET_PAPER_MAKER_FLOW_HOLD_S=15
POLYMARKET_PAPER_MAKER_FLOW_WINDOW_S=10
POLYMARKET_PAPER_MAKER_FLOW_MEDIAN_S=1800
POLYMARKET_PAPER_MAKER_FLOW_MULT=3
POLYMARKET_PAPER_MAKER_SWEEP_LEVELS=2
POLYMARKET_PAPER_MAKER_SWEEP_WINDOW_S=5
POLYMARKET_PAPER_MAKER_FILL_TICKS=1
POLYMARKET_PAPER_MAKER_FILL_HOLD_S=10
POLYMARKET_PAPER_MAKER_FILL_SIZE_MULT=.5
POLYMARKET_PAPER_MAKER_MOMENTUM_SIGMA=2
POLYMARKET_PAPER_MAKER_SOFT_SIZE_MULT=.5
POLYMARKET_PAPER_MAKER_SOFT_TICKS=1
# Phases: interval:reduce:hedge:flat seconds before expiry; pre-open windows before the strike window.
POLYMARKET_PAPER_MAKER_PREOPEN_WINDOWS=5m:120,15m:300,1h:900,4h:1800,1d:3600
POLYMARKET_PAPER_MAKER_PREOPEN_PULL_S=5
POLYMARKET_PAPER_MAKER_STRIKE_WAIT_S=2
POLYMARKET_PAPER_MAKER_PHASES=5m:120:60:20,15m:180:90:30,1h:300:120:30,4h:600:180:60,1d:900:300:60
# Order management and guards (book/spot staleness are data-quality calms: cancel all).
POLYMARKET_PAPER_MAKER_MIN_REST_MS=500
POLYMARKET_PAPER_MAKER_UP_PERSIST_MS=300
POLYMARKET_PAPER_MAKER_RESIZE_RATIO=.5
POLYMARKET_PAPER_MAKER_MAX_ACTIONS_PER_MARKET_S=5
POLYMARKET_PAPER_MAKER_BOOK_STALE_MS=2000
POLYMARKET_PAPER_MAKER_BOOK_STALE_MS_SHORT=2000
POLYMARKET_PAPER_MAKER_UPDOWN_SYNC_MS=250
# Rows are written only when the top five levels change: a quiet book stays current up to BOOK_QUIET_MS
# while the recorder wrote any book row within FEED_STALE_MS (recorder/writer liveness).
POLYMARKET_PAPER_MAKER_BOOK_QUIET_MS=60000
POLYMARKET_PAPER_MAKER_FEED_STALE_MS=2000
# 6000 suits the 5 s REST reference; use 1000 with the spot WebSocket on.
POLYMARKET_PAPER_MAKER_SPOT_STALE_MS=6000
POLYMARKET_PAPER_MAKER_JUMP_SIGMA=4
POLYMARKET_PAPER_MAKER_JUMP_COOLDOWN_MS=3000
POLYMARKET_PAPER_MAKER_FV_ADVERSE_FRAC=.5
POLYMARKET_PAPER_MAKER_DEPTH_PULL_FRAC=1
POLYMARKET_PAPER_MAKER_DEPTH_PULL_WINDOW_MS=1500
POLYMARKET_PAPER_MAKER_DEPTH_PULL_COOLDOWN_MS=500
POLYMARKET_PAPER_MAKER_EVENT_BLACKOUT_MIN=10
POLYMARKET_PAPER_MAKER_EVENT_TIMES=
# Risk caps constrain risk-side quotes only; hedges are always allowed. Stops are USD loss magnitudes.
# WEEKLY_STOP latches state.maker.halt until an operator clears it after review.
POLYMARKET_PAPER_MAKER_N_CAP_COIN_DIR=60
POLYMARKET_PAPER_MAKER_N_CAP_GLOBAL_DIR=100
POLYMARKET_PAPER_MAKER_WORST_LOSS_MARKET=12
POLYMARKET_PAPER_MAKER_WORST_LOSS_GLOBAL=75
POLYMARKET_PAPER_MAKER_LOCK_MARKET=100
POLYMARKET_PAPER_MAKER_LOCK_GLOBAL=1000
POLYMARKET_PAPER_MAKER_DAILY_SOFT_STOP=50
POLYMARKET_PAPER_MAKER_DAILY_HARD_STOP=100
POLYMARKET_PAPER_MAKER_CELL_DAILY_STOP=25
POLYMARKET_PAPER_MAKER_WEEKLY_STOP=200
POLYMARKET_PAPER_MAKER_AS_ALERT_SIGMA=2
# Pessimistic simulator: latency, queue, complementary prints (verify = never counted).
POLYMARKET_PAPER_MAKER_PLACE_LATENCY_MS=250
POLYMARKET_PAPER_MAKER_CANCEL_LATENCY_MS=250
POLYMARKET_PAPER_MAKER_PRINT_LAG_MS=2000
POLYMARKET_PAPER_MAKER_COMPLEMENTARY_PRINTS=verify
POLYMARKET_PAPER_MAKER_SETTLE_TIMEOUT_S=3600
# Seconds past the final print to wait for the official result before the Binance proxy
# (Binance 1h/1d cells resolve via UMA ~11-18 min after the end; Chainlink ~1 min). <= SETTLE_TIMEOUT_S.
POLYMARKET_PAPER_MAKER_OFFICIAL_WAIT_BINANCE_S=1800
POLYMARKET_PAPER_MAKER_OFFICIAL_WAIT_CHAINLINK_S=300
# Rebate values are scenarios (0/50/100%) only, never credited to cash or PnL.
POLYMARKET_PAPER_MAKER_REBATE_FEE_RATE=.07
POLYMARKET_PAPER_MAKER_REBATE_POOL_FRACTION=.20

# Pair signal admission only; individual age gates remain unchanged (default 2s).
POLYMARKET_OBSERVER_MAX_PAIR_SKEW_MS=250
# Current account-wide annotation, including historical/WS-only reports.
# Only unverified is recognized; absent/invalid values return unspecified.
POLYMARKET_PAPER_ACCOUNT_TAKER_STATUS=unspecified

# Independent US research screener. No agent symbols/tasks/orders are modified.
# Celery beat ticks every minute; XNYS session days at/after 16:30 New York (DST).
US_SCREENER_ENABLED=false
# Capture quotes near the XNYS close even when daily screening is disabled.
US_SCREENER_RTH_CAPTURE_ENABLED=false
# Missing observed RTH spreads: flag (default) or exclude.
US_SCREENER_UNVERIFIED_SPREAD=flag
# Unknown earnings: flag (default) or exclude; open/closed are legacy aliases.
US_SCREENER_EARNINGS_UNKNOWN=flag
US_SCREENER_MIN_COVERAGE=0.9
# Empty resolved Nasdaq-100 only: explicit comma-separated manual research fallback.
US_SCREENER_MANUAL_SYMBOLS=
