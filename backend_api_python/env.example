PROFESSIONAL_REPORT_DATA_TIER=community
# Maximum account-equity loss budget used by deterministic position sizing.
PROFESSIONAL_REPORT_RISK_BUDGET_PCT=1.0
# Optional: broad global headlines are displayed as background and never
